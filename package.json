{
  "name": "nemo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@types/dagre": "^0.7.52",
    "axios": "^1.13.1",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.1",
    "js-yaml": "^4.1.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.47",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "svg2pdf.js": "^2.7.0",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "dev": "vite",
